{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mc2-agent",
  "main": "src/server.ts",
  "compatibility_date": "2025-02-04",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
  ],
  "assets": {
    "directory": "public",
  },
  "vars": {
    "ENABLE_AUTO_GENERATED_UI": "false",
    "ENABLE_DEBUG_MODE": "false",
    "ENABLE_FEEDBACK_SYSTEM": "true",
    "ENABLE_AI_ELEMENTS": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Chat",
        "class_name": "Chat",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Chat"],
    },
  ],
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    {
      "binding": "MCP_CACHE_KV",
      "id": "a142ddf58a9e421488977d88270894bb",
      "preview_id": "a7163488bb824a0daa9a6409b585d1f5"
    }
  ],
}
